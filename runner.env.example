# Copy to runner.env (gitignored) and fill in. Never commit runner.env.

# The repository the runners register with (owner/repo).
RUNNER_REPOSITORY=owner/repo

# Fine-grained personal access token scoped to that repository only, with the
# "Administration: Read and write" permission. It is used only to request short-lived
# runner registration and removal tokens, and job steps never see it.
GITHUB_TOKEN=

# Extra runner labels, comma-separated (GitHub adds self-hosted, Linux and X64).
RUNNER_LABELS=ci

# One job per registration (recommended).
RUNNER_EPHEMERAL=true
